IMAGE_TAG=latest
BIND_ADDRESS=127.0.0.1
HOST_PORT=8000
LLM_API_KEY=replace-me
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
AGENT_DB_PATH=/data/customer-service-agent.db
AGENT_AUTH_REQUIRED=true
AGENT_API_KEY=replace-with-a-random-key
AGENT_DOCS_ENABLED=false
AGENT_CORS_ORIGINS=
AGENT_KNOWLEDGE_ENABLED=true
AGENT_KNOWLEDGE_DIR=/app/knowledge_docs
AGENT_ORDER_PROVIDER=memory
AGENT_ORDER_API_BASE_URL=https://orders.example.invalid
AGENT_ORDER_API_TOKEN=replace-with-order-api-token
AGENT_ORDER_CONNECT_TIMEOUT_SECONDS=2
AGENT_ORDER_READ_TIMEOUT_SECONDS=5
AGENT_ORDER_MAX_ATTEMPTS=2
AGENT_ORDER_CIRCUIT_FAILURE_THRESHOLD=5
AGENT_ORDER_CIRCUIT_COOLDOWN_SECONDS=30
